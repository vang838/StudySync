# Peer Testing Backup AI/LLM Cloudflare Config
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=<YOUR_GEMINI_API_KEY>
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT=120

# generate your own key by running the commands based on linux/max or windows ps:
# Linux/macOS: openssl rand -hex 32
# Windows PowerShell (5.1+): $b = New-Object byte[] 32; $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($b); $rng.Dispose(); [BitConverter]::ToString($b).Replace('-', '').ToLowerInvariant()
SEARXNG_SECRET= 

