# Peer Testing MAIN AI/LLM Groq Config
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=<YOUR_GROQ_API_KEY>
AI_MODEL=openai/gpt-oss-120b
